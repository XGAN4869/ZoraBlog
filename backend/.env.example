# 这些是开发示例，不是生产密钥。真实 `.env` 必须加入 `.gitignore`。
# 复制到 backend/.env 后替换为自己的配置，程序会自动读取；真实 .env 必须忽略。
APP_ENV=development
PORT=8080
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=blog_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_HOST_PORT=3307
DATABASE_DSN=blog:blog_dev_password@tcp(127.0.0.1:3307)/blog?parseTime=true
# 在 https://github.com/settings/applications/new 创建 OAuth App 后填写。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
COOKIE_SECURE=false
# 生产环境需 HTTPS 来源与 Secure Cookie。
PUBLIC_ORIGIN=http://localhost:5173
TRUSTED_PROXIES=
