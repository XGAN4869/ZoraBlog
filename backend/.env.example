# 这些是开发示例，不是生产密钥。真实 `.env` 必须加入 `.gitignore`。
# 的作用不是让程序自动读取，而是告诉新开发者“启动项目需要哪些变量”。真正的 `.env` 会包含个人密码，因此必须忽略。
APP_ENV=development
PORT=8080
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=blog_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_HOST_PORT=3307
DATABASE_DSN=blog:blog_dev_password@tcp(127.0.0.1:3307)/bl